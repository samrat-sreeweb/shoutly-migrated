# Copy to .env and fill in real values.
# Get your Outstand key: https://www.outstand.so/app -> Get API Key

PORT=3000
OUTSTAND_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
OUTSTAND_BASE_URL=https://api.outstand.so

# Optional — used by POST /api/networks when body omits key/secret
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# X (Twitter) BYOK — API Key + API Secret from console.x.com
# Callback URL in X app User auth settings MUST be:
#   https://www.outstand.so/app/api/socials/x/callback
X_CONSUMER_KEY=
X_SECRET_KEY=
# Optional aliases (same values):
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# After OAuth, Outstand can bounce users back here (pass as redirectUri)
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/oauth/callback

# CORS origin for the Vite React frontend (default below)
CORS_ORIGIN=http://localhost:5173
