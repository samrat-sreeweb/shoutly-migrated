# Copy to .env and fill in real values.
# Get your Outstand key: https://www.outstand.so/app -> Get API Key

PORT=3000
OUTSTAND_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
OUTSTAND_BASE_URL=https://api.outstand.so

# Facebook — callback: https://www.outstand.so/app/api/socials/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram (often a separate Meta app) —
# callback: https://www.outstand.so/app/api/socials/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Threads (Meta) —
# callback: https://www.outstand.so/app/api/socials/threads/callback
THREAD_APP_ID=
THREAD_APP_SECRET=

# X (Twitter) OAuth 2.0 Client ID/Secret preferred —
# callback: https://www.outstand.so/app/api/socials/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CONSUMER_KEY=
X_SECRET_KEY=

# YouTube (Google Cloud Web OAuth client) —
# callback: https://www.outstand.so/app/api/socials/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok —
# callback: https://www.outstand.so/app/api/socials/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Pinterest —
# callback: https://www.outstand.so/app/api/socials/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Bluesky — no OAuth app. Visitors connect with handle + app password in the UI
# (https://bsky.app/settings/app-passwords). Outstand still needs a
# social-networks row; placeholders work:
BLUESKY_CLIENT_KEY=bluesky
BLUESKY_CLIENT_SECRET=bluesky
# Optional local notes (paste into the UI form — not used by the public API):
# BLUESKY_HANDLE=you.bsky.social
# BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# After OAuth, Outstand can bounce users back here (pass as redirectUri)
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/oauth/callback

# CORS origin for the Vite React frontend (default below)
CORS_ORIGIN=http://localhost:5173
