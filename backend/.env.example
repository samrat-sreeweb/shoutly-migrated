# Copy to .env and fill in real values.
# Get your Outstand key: https://www.outstand.so/app -> Get API Key

PORT=3000
OUTSTAND_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
OUTSTAND_BASE_URL=https://api.outstand.so

# Optional — used by POST /api/networks when body omits key/secret
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# CORS origin for the Vite React frontend (default below)
CORS_ORIGIN=http://localhost:5173
